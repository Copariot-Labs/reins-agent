# Hermes WeCom AI Bot
WECOM_BOT_ID=your-wecom-ai-bot-id
WECOM_SECRET=your-wecom-ai-bot-secret
WECOM_GROUP_POLICY=allowlist
# WECOM_GROUP_ALLOW_FROM=your-work-order-group-id

# Protects the optional Reins HTTP intake/reply endpoints.
REINS_WECOM_INGEST_API_KEY=replace-with-a-long-random-secret

# WeCom self-built application: sends private messages to staff members.
REINS_WECOM_CORP_ID=ww_your_corp_id
REINS_WECOM_APP_SECRET=your-internal-application-secret
REINS_WECOM_APP_AGENT_ID=1000002

# WeCom member UserIDs. Separate multiple recipients with |, comma, semicolon, or space.
REINS_WECOM_NOTIFY_USERS_PROPERTY=property_user_1|property_user_2
REINS_WECOM_NOTIFY_USERS_CLEANING=cleaner_user_1|cleaner_user_2
REINS_WECOM_NOTIFY_USERS_POLICE=police_user_1
REINS_WECOM_NOTIFY_USERS_HOSPITAL=doctor_user_1|doctor_user_2
REINS_WECOM_NOTIFY_USERS_COMMUNITY=community_user_1
REINS_WECOM_NOTIFY_USERS_HUMAN_REVIEW=supervisor_user_1
REINS_WECOM_NOTIFY_USERS_DEFAULT=supervisor_user_1
