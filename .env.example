# Internal work-order API intake. The token comes from the kf.lnluo.com API owner.
REINS_TICKET_API_URL=https://kf.lnluo.com/internal/tickets
REINS_TICKET_API_TOKEN=replace-with-the-ticket-api-bearer-token
REINS_TICKET_API_STATUSES=pending_dispatch,dispatched,reopened,notification_failed
REINS_TICKET_API_LIMIT=20
REINS_TICKET_API_POLL_INTERVAL=30
REINS_TICKET_API_TIMEOUT=15

# Optional: keep a staff-visible Excel copy outside the hidden .reins folder.
# The file is named 社区工单台账.xlsx and is refreshed after every ticket update.
# REINS_WECOM_EXPORT_DIR=~/Documents/Reins

# Set this to true only on the computer that should send WeCom group notifications.
# Other computers can use false and will still fetch, route, save, and display work orders.
REINS_WECOM_NOTIFY_ENABLED=false

# Robot webhook from the single WeCom operations group. Treat the key as a secret.
# Required only when REINS_WECOM_NOTIFY_ENABLED=true.
REINS_WECOM_NOTIFY_GROUP_WEBHOOK=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=replace-with-group-robot-key

# Bot name staff should mention when posting the completion result.
REINS_WECOM_REPLY_BOT_NAME=社区美女

# Internal WeCom UserIDs for real @mentions. Each user must belong to the target group.
# Separate multiple recipients with |, comma, semicolon, or space. @all is rejected.
# Use different values for roles handled by different people.
REINS_WECOM_NOTIFY_USERS_PROPERTY=property_user_1|property_user_2
REINS_WECOM_NOTIFY_USERS_CLEANING=cleaner_user_1|cleaner_user_2
REINS_WECOM_NOTIFY_USERS_POLICE=police_user_1
REINS_WECOM_NOTIFY_USERS_HOSPITAL=doctor_user_1|doctor_user_2
REINS_WECOM_NOTIFY_USERS_COMMUNITY=community_user_1
REINS_WECOM_NOTIFY_USERS_HUMAN_REVIEW=supervisor_user_1
REINS_WECOM_NOTIFY_USERS_DEFAULT=supervisor_user_1

# Hybrid assignment uses deterministic routing for known categories and the
# configured Hermes provider for ambiguous tickets. Use shadow to record AI
# proposals without changing recipients, or rules to disable model routing.
REINS_WECOM_ROUTING_MODE=hybrid
REINS_WECOM_ROUTING_CONFIDENCE=0.85
REINS_WECOM_ROUTING_TIMEOUT=15
