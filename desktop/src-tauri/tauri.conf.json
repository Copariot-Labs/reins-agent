{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Reins",
  "mainBinaryName": "Reins",
  "version": "0.1.8",
  "identifier": "com.copariot.reins",
  "build": {
    "beforeDevCommand": {
      "script": "pnpm run dev:client",
      "cwd": "../../web",
      "wait": false
    },
    "beforeBuildCommand": {
      "script": "pnpm build",
      "cwd": "../../web"
    },
    "devUrl": "http://localhost:8649",
    "frontendDist": "../../web/dist/client"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Reins",
        "visible": false,
        "width": 1400,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 650,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
