{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Reins",
  "version": "0.1.0",
  "identifier": "com.copariot.reins",
  "build": {
    "devUrl": "http://localhost:8649",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Reins",
        "width": 1400,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 650,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
